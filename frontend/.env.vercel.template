# =============================================================================
# VERCEL FRONTEND DEPLOYMENT ENVIRONMENT VARIABLES TEMPLATE
# =============================================================================
# 
# Instructions:
# 1. Copy this file to create your production environment configuration
# 2. Replace all placeholder values with your actual production values
# 3. Add these variables to your Vercel project dashboard
# 4. NEVER commit actual secrets to version control
#
# =============================================================================

# =============================================================================
# CORE CONFIGURATION
# =============================================================================

# Environment mode - MUST be production for Vercel
NODE_ENV=production

# Angular build environment
NG_BUILD_ENV=production

# =============================================================================
# API CONFIGURATION - CRITICAL FOR DEPLOYMENT
# =============================================================================

# Backend API URL - Replace with your actual backend deployment URL
# REQUIRED: This is where your Angular app will make API calls
# Format: https://your-backend-service.platform.com/api
# Examples:
#   Render: https://your-backend.onrender.com/api
#   Heroku: https://your-app.herokuapp.com/api
#   Railway: https://your-app.up.railway.app/api
NEXT_PUBLIC_API_URL=https://your-backend.onrender.com/api

# WebSocket/Socket.IO URL - Replace with your actual backend deployment URL
# REQUIRED: This is for real-time features (chat, notifications)
# Should be the same as API URL but without the /api suffix
# Format: https://your-backend-service.platform.com
NEXT_PUBLIC_SOCKET_URL=https://your-backend.onrender.com

# Frontend URL - Your Vercel deployment URL
# This will be automatically set by Vercel, but you can override if needed
# Used for CORS configuration and redirects
# Format: https://your-frontend.vercel.app
NEXT_PUBLIC_FRONTEND_URL=https://your-frontend.vercel.app

# =============================================================================
# BUILD-TIME CONFIGURATION
# =============================================================================

# Enable Angular production optimizations
NG_BUILD_OPTIMIZATION=true

# Enable source maps for debugging (set to false for production)
NG_BUILD_SOURCE_MAP=false

# Enable build caching for faster builds
NG_BUILD_CACHE=true

# Angular build mode
NG_BUILD_MODE=production

# =============================================================================
# FEATURE FLAGS (Optional)
# =============================================================================

# Enable analytics tracking
NEXT_PUBLIC_ENABLE_ANALYTICS=true

# Enable error reporting
NEXT_PUBLIC_ENABLE_ERROR_REPORTING=true

# Enable performance monitoring
NEXT_PUBLIC_ENABLE_PERFORMANCE_MONITORING=true

# Enable debug mode (set to false for production)
NEXT_PUBLIC_DEBUG_MODE=false

# =============================================================================
# SECURITY CONFIGURATION (Optional)
# =============================================================================

# Enable Content Security Policy
CSP_ENABLED=true

# Enable HTTPS redirect (Vercel handles this automatically)
HTTPS_REDIRECT=true

# Enable security headers
SECURITY_HEADERS_ENABLED=true

# =============================================================================
# THIRD-PARTY INTEGRATIONS (Optional)
# =============================================================================

# Google Analytics ID (if using analytics)
NEXT_PUBLIC_GA_ID=your_google_analytics_id

# Sentry DSN (if using error tracking)
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn

# LogRocket App ID (if using session recording)
NEXT_PUBLIC_LOGROCKET_APP_ID=your_logrocket_app_id

# =============================================================================
# VERCEL-SPECIFIC CONFIGURATION NOTES
# =============================================================================

# 1. ENVIRONMENT VARIABLE NAMING:
#    - Use NEXT_PUBLIC_ prefix for variables that need to be accessible in the browser
#    - Variables without this prefix are only available during build time
#    - Vercel automatically injects VERCEL_URL and VERCEL_ENV

# 2. AUTOMATIC VARIABLES:
#    Vercel automatically provides these variables:
#    - VERCEL_URL: Your deployment URL
#    - VERCEL_ENV: Environment (production, preview, development)
#    - VERCEL_GIT_COMMIT_SHA: Git commit hash
#    - VERCEL_GIT_COMMIT_MESSAGE: Git commit message

# 3. ENVIRONMENT SCOPES:
#    - Production: Used for production deployments
#    - Preview: Used for preview deployments (pull requests)
#    - Development: Used for local development

# 4. BUILD CONFIGURATION:
#    - Framework: Angular (automatically detected)
#    - Build Command: npm run build:prod
#    - Output Directory: dist/healthcare-platform-frontend
#    - Install Command: npm ci

# =============================================================================
# DEPLOYMENT EXAMPLES
# =============================================================================

# --- RENDER BACKEND + VERCEL FRONTEND ---
# Backend on Render: https://your-backend.onrender.com
# Frontend on Vercel: https://your-frontend.vercel.app
# Configuration:
# NEXT_PUBLIC_API_URL=https://your-backend.onrender.com/api
# NEXT_PUBLIC_SOCKET_URL=https://your-backend.onrender.com
# NEXT_PUBLIC_FRONTEND_URL=https://your-frontend.vercel.app

# --- HEROKU BACKEND + VERCEL FRONTEND ---
# Backend on Heroku: https://your-app.herokuapp.com
# Frontend on Vercel: https://your-frontend.vercel.app
# Configuration:
# NEXT_PUBLIC_API_URL=https://your-app.herokuapp.com/api
# NEXT_PUBLIC_SOCKET_URL=https://your-app.herokuapp.com
# NEXT_PUBLIC_FRONTEND_URL=https://your-frontend.vercel.app

# --- CUSTOM DOMAIN SETUP ---
# If using custom domains:
# NEXT_PUBLIC_API_URL=https://api.yourdomain.com
# NEXT_PUBLIC_SOCKET_URL=https://api.yourdomain.com
# NEXT_PUBLIC_FRONTEND_URL=https://app.yourdomain.com

