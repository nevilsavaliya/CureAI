# =============================================================================
# DOCKER COMPOSE ENVIRONMENT CONFIGURATION
# =============================================================================
# This file contains environment variables for Docker Compose deployments
# Copy this file to .env in your project root and update the values

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Node.js environment
NODE_ENV=production

# Application ports
PORT=3000
BACKEND_PORT=3000
BACKEND_HTTP_PORT=3000
BACKEND_HTTPS_PORT=3443

# Frontend ports
FRONTEND_HTTP_PORT=80
FRONTEND_HTTPS_PORT=443
HTTP_PORT=80
HTTPS_PORT=443

# =============================================================================
# URL CONFIGURATION
# =============================================================================

# Backend URLs (use service names for internal communication)
API_BASE_URL=http://backend:3000
API_URL=http://backend:3000/api
SOCKET_URL=http://backend:3000

# Frontend URL (use service name for internal communication)
FRONTEND_URL=http://frontend:80

# Health check URLs
HEALTH_CHECK_URL=http://backend:3000/api/health
FRONTEND_HEALTH_CHECK_URL=http://frontend:80/
FRONTEND_HEALTH_CHECK_URL_FALLBACK=http://frontend:80/

# CORS configuration (allow frontend service)
CORS_ORIGINS=http://frontend:80

# =============================================================================
# SSL/HTTPS CONFIGURATION (for docker-compose.ssl.yml)
# =============================================================================

# SSL settings
SSL_ENABLED=true
SSL_PORT=3443
SSL_CERT_PATH=/app/certs
SSL_KEY_FILE=server.key
SSL_CERT_FILE=server.crt
SSL_CA_FILE=ca.crt

# Server name for SSL certificates
SERVER_NAME=localhost

# Backend URL for HTTPS
BACKEND_URL=https://backend:3443

# HTTPS Health check URLs
HEALTH_CHECK_URL=https://backend:3443/api/health
FRONTEND_HEALTH_CHECK_URL=https://frontend:443/
FRONTEND_HEALTH_CHECK_URL_FALLBACK=http://frontend:80/

# HTTPS CORS configuration
CORS_ORIGINS=https://frontend:443

# =============================================================================
# HEALTH CHECK CONFIGURATION
# =============================================================================

# Health check timing configuration
HEALTH_CHECK_INTERVAL=30s
HEALTH_CHECK_TIMEOUT=10s
HEALTH_CHECK_RETRIES=3
HEALTH_CHECK_START_PERIOD=40s

# Frontend health check timing
FRONTEND_HEALTH_CHECK_INTERVAL=30s
FRONTEND_HEALTH_CHECK_TIMEOUT=10s
FRONTEND_HEALTH_CHECK_RETRIES=3
FRONTEND_HEALTH_CHECK_START_PERIOD=40s

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# MongoDB configuration
MONGODB_URI=mongodb://admin:password@mongodb:27017/healthcare-platform?authSource=admin
MONGODB_VERSION=6
MONGODB_PORT=27017
MONGODB_ROOT_USERNAME=admin
MONGODB_ROOT_PASSWORD=password
MONGODB_DATABASE=healthcare-platform

# Redis configuration (optional)
REDIS_VERSION=7-alpine
REDIS_PORT=6379
REDIS_PASSWORD=healthcare123

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# JWT configuration
JWT_SECRET=your-super-secure-jwt-secret-change-this-in-production
JWT_EXPIRES_IN=24h

# Encryption key for E2E messaging
ENCRYPTION_MASTER_KEY=your_64_character_hex_encryption_master_key_here_make_it_secure_and_random

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================

EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_specific_password

# =============================================================================
# API CONFIGURATION
# =============================================================================

API_RATE_LIMIT=100
HOSPITAL_API_KEY_PREFIX=HK_
HOSPITAL_API_SECRET_LENGTH=64

# =============================================================================
# PAYMENT CONFIGURATION
# =============================================================================

# Payment timeouts and retries
PAYMENT_TIMEOUT_MINUTES=10
PAYMENT_POLL_INTERVAL_SECONDS=5
PAYMENT_MAX_RETRIES=3

# Razorpay configuration
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
UPI_ID=9909232769@superyes

# Kotak UPI configuration
KOTAK_API_BASE_URL=https://apigwuat.kotak.com:8443
KOTAK_CLIENT_ID=your_kotak_client_id
KOTAK_CLIENT_SECRET=your_kotak_client_secret
KOTAK_MERCHANT_VPA=merchant@kotak
KOTAK_MERCHANT_MOBILE=919XXXXXXXXX
KOTAK_AGGREGATOR_ID=AC001
KOTAK_MERCHANT_ID=MC001
KOTAK_SECRET_KEY=your_kotak_secret_key

# =============================================================================
# SSL CERTIFICATE CONFIGURATION (for production)
# =============================================================================

# Let's Encrypt configuration
LETSENCRYPT_EMAIL=your-email@domain.com
CERTBOT_VERSION=latest

# =============================================================================
# DOCKER COMPOSE PROFILES
# =============================================================================
# Use these profiles to control which services are started:
# 
# Start with local database:
# docker-compose --profile local-db up
#
# Start with cache (Redis):
# docker-compose --profile cache up
#
# Start with SSL and production certificates:
# docker-compose -f docker-compose.ssl.yml --profile production up
#
# Start everything:
# docker-compose --profile local-db --profile cache up

# =============================================================================
# USAGE EXAMPLES
# =============================================================================

# 1. LOCAL DEVELOPMENT WITH DOCKER:
#    - Copy this file to .env
#    - Update database credentials
#    - Run: docker-compose --profile local-db up

# 2. PRODUCTION DEPLOYMENT WITH SSL:
#    - Update SERVER_NAME with your domain
#    - Set LETSENCRYPT_EMAIL
#    - Update all URLs to use your domain
#    - Run: docker-compose -f docker-compose.ssl.yml --profile production up

# 3. STAGING ENVIRONMENT:
#    - Update URLs to use staging domains
#    - Use staging database credentials
#    - Run: docker-compose up

# =============================================================================
# SECURITY NOTES
# =============================================================================

# - Never commit this file with real secrets to version control
# - Use Docker secrets or external secret management in production
# - Regularly rotate passwords and API keys
# - Use strong, unique passwords for all services
# - Monitor logs for security issues