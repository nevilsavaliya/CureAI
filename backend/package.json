{
  "name": "healthcare-platform-backend",
  "version": "1.0.0",
  "description": "Healthcare Platform MVP Backend API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "setup": "node scripts/setup-env.js",
    "setup:validate": "node scripts/setup-env.js --validate",
    "seed": "node scripts/seedData.js",
    "clean": "node scripts/cleanDatabase.js",
    "cleanup": "node scripts/cleanDatabase.js",
    "cleanup:dry-run": "node scripts/cleanDatabase.js --dry-run",
    "cleanup:messages": "node scripts/cleanDatabase.js --messages",
    "cleanup:conversations": "node scripts/cleanDatabase.js --conversations",
    "cleanup:cases": "node scripts/cleanDatabase.js --cases",
    "cleanup:all": "node scripts/cleanDatabase.js --all",
    "reset": "node scripts/reset-database.js",
    "reset:quick": "node scripts/quick-reset.js",
    "test": "jest --runInBand --detectOpenHandles",
    "test:patient": "jest backend/tests/integration/patient-flow.test.js --runInBand",
    "test:doctor": "jest backend/tests/integration/doctor-flow.test.js --runInBand",
    "test:admin": "jest backend/tests/integration/admin-flow.test.js --runInBand",
    "test:email": "jest backend/tests/integration/email-video.test.js --runInBand",
    "test:security": "jest backend/tests/adminSecurityService.test.js backend/tests/adminSecurityController.test.js --runInBand",
    "test:integration:security": "jest backend/tests/integration/admin-security-flow.test.js --runInBand",
    "test:e2e:admin": "jest backend/tests/e2e/admin-user-management-e2e.test.js --runInBand",
    "test:security:privilege": "jest backend/tests/security/privilege-escalation.test.js --runInBand",
    "test:admin:all": "jest backend/tests/adminUserManagementController.test.js backend/tests/adminSecurityService.test.js backend/tests/adminSecurityController.test.js backend/tests/integration/admin-security-flow.test.js backend/tests/e2e/admin-user-management-e2e.test.js backend/tests/security/privilege-escalation.test.js --runInBand",
    "log-monitor": "node scripts/log-monitor.js",
    "logs": "node scripts/log-monitor.js",
    "migrate:hospital": "node scripts/migrate-hospital-feature.js",
    "migrate:hospital:verify": "node scripts/verify-hospital-migration.js",
    "migrate:hospital:rollback": "node scripts/rollback-hospital-feature.js",
    "migrate:status": "node scripts/check-migration-status.js",
    "deploy:render": "node scripts/deploy-render.js",
    "deploy:heroku": "node scripts/deploy-heroku.js",
    "deploy:docker": "node scripts/deploy-docker.js",
    "deploy:validate": "node scripts/validate-deployment.js"
  },
  "keywords": [
    "healthcare",
    "api",
    "express"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.6.3",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^6.10.1",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.6",
    "socket.io": "^4.8.1",
    "speakeasy": "^2.0.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "validator": "^13.15.23",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.3.0",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.3"
  }
}
