# ========================================
# PRODUCTION ENVIRONMENT VARIABLES
# For Render Deployment
# ========================================

# Server Configuration
NODE_ENV=production
PORT=3000

# Database Configuration
# TODO: Replace with your MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/healthcare-platform?retryWrites=true&w=majority

# JWT Configuration
# TODO: Generate a new secure secret key (32+ characters)
# Run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING_AT_LEAST_32_CHARACTERS
JWT_EXPIRES_IN=24h

# CORS Configuration
# TODO: Replace with your actual frontend URL after deployment
FRONTEND_URL=https://your-frontend-app.vercel.app

# Email Configuration (Required for notifications and alerts)
# MailerSend is the recommended email service for production
# TODO: Sign up at https://www.mailersend.com/ and verify your domain
# TODO: Get API key from: https://app.mailersend.com/api-tokens
# TODO: Replace with your verified sender email and domain
MAILERSEND_API_KEY=your_mailersend_api_key_here
MAILERSEND_FROM_EMAIL=no-reply@yourdomain.com
MAILERSEND_FROM_NAME=Healthcare Platform

# Legacy Gmail SMTP Configuration (Deprecated)
# Only uncomment if you haven't migrated to MailerSend yet
# See MAILERSEND_MIGRATION_GUIDE.md for migration instructions
# EMAIL_USER=your_email@gmail.com
# EMAIL_PASSWORD=your_app_specific_password

# Hospital Feature Configuration
# API rate limiting for hospital API access (requests per hour)
API_RATE_LIMIT=100
# Prefix for hospital API keys
HOSPITAL_API_KEY_PREFIX=HK_
# Length of hospital API secret (in bytes, will be hex encoded)
HOSPITAL_API_SECRET_LENGTH=64

# Razorpay Configuration (Optional - if using Razorpay for payments)
# TODO: Get from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
UPI_ID=your_upi_id@bank

# Kotak UPI Payment Gateway Configuration (Optional - if using Kotak)
# TODO: Get these from Kotak after merchant account approval
KOTAK_API_BASE_URL=https://api.kotak.com/upi
KOTAK_CLIENT_ID=your_kotak_client_id
KOTAK_CLIENT_SECRET=your_kotak_client_secret
KOTAK_MERCHANT_VPA=yourname@kotak
KOTAK_MERCHANT_MOBILE=919876543210
KOTAK_AGGREGATOR_ID=your_aggregator_id
KOTAK_MERCHANT_ID=your_merchant_id
KOTAK_SECRET_KEY=your_32_character_secret_key

# Payment Configuration
PAYMENT_TIMEOUT_MINUTES=10
PAYMENT_POLL_INTERVAL_SECONDS=5
PAYMENT_MAX_RETRIES=3
