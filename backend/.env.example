# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Application port - will be set automatically by cloud platforms like Render
PORT=3000

# Environment mode - set to 'production' for deployed environments
NODE_ENV=development

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# MongoDB connection string
# Development: Use local MongoDB instance
# Production: Use cloud MongoDB service (MongoDB Atlas recommended)
MONGODB_URI=mongodb://localhost:27017/healthcare-platform

# =============================================================================
# SSL/TLS CONFIGURATION
# =============================================================================

# SSL/TLS Configuration
# Enable SSL for HTTPS connections (recommended for production)
SSL_ENABLED=false
SSL_PORT=3443
SSL_CERT_PATH=./certs
SSL_KEY_FILE=server.key
SSL_CERT_FILE=server.crt
SSL_CA_FILE=ca.crt

# SSL Certificate Configuration
# Domain name for SSL certificate generation
SSL_DOMAIN=localhost
SSL_ORGANIZATION=Healthcare Platform
SSL_OU=IT Department
SSL_COUNTRY=US
SSL_STATE=State
SSL_CITY=City

# Additional domains and IPs for certificate Subject Alternative Names
# Comma-separated list of additional domains
SSL_ALT_NAMES=
# Comma-separated list of additional IP addresses
SSL_ALT_IPS=

# Certificate type for automated setup (self-signed or letsencrypt)
SSL_CERT_TYPE=self-signed

# Let's Encrypt configuration (for production SSL certificates)
LETSENCRYPT_EMAIL=

# =============================================================================
# SECURITY HEADERS CONFIGURATION
# =============================================================================

# HTTP Strict Transport Security (HSTS) configuration
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=true

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# JWT secret key - MUST be changed in production
# Generate a secure random string for production deployments
JWT_SECRET=your-secret-key-change-this-in-production
JWT_EXPIRES_IN=24h

# Encryption master key for E2E message encryption
# MUST be exactly 64 characters (hex) - generate securely for production
ENCRYPTION_MASTER_KEY=your_64_character_hex_encryption_master_key_here_make_it_secure_and_random

# =============================================================================
# URL CONFIGURATION (CRITICAL FOR DEPLOYMENT)
# =============================================================================

# Frontend application URL - where your Angular app is hosted
# Development: http://localhost:4200
# Vercel: https://your-app.vercel.app
# Netlify: https://your-app.netlify.app
FRONTEND_URL=http://localhost:4200

# Backend API base URL - where this Node.js server is accessible
# Development: http://localhost:3000/api
# Render: https://your-backend.onrender.com/api
# Heroku: https://your-app.herokuapp.com/api
API_URL=http://localhost:3000/api

# Backend base URL (without /api suffix) - used for health checks and root endpoints
# Development: http://localhost:3000
# Render: https://your-backend.onrender.com
# Heroku: https://your-app.herokuapp.com
API_BASE_URL=http://localhost:3000

# WebSocket/Socket.IO URL - typically same as API_BASE_URL
# If not specified, will default to API_BASE_URL
# Development: http://localhost:3000
# Production: https://your-backend.onrender.com
SOCKET_URL=http://localhost:3000

# Health check endpoint URL - used by Docker and cloud platforms
# If not specified, will default to ${API_BASE_URL}/api/health
# Development: http://localhost:3000/api/health
# Production: https://your-backend.onrender.com/api/health
HEALTH_CHECK_URL=http://localhost:3000/api/health

# =============================================================================
# CORS CONFIGURATION
# =============================================================================

# Allowed CORS origins - comma-separated list of frontend URLs
# IMPORTANT: Must include all domains that will access your API
# Development: http://localhost:4200
# Production: Include all your frontend domains
CORS_ORIGINS=http://localhost:4200

# Examples for different deployment scenarios:
# Single frontend: CORS_ORIGINS=https://your-frontend.vercel.app
# Multiple frontends: CORS_ORIGINS=https://your-frontend.vercel.app,https://your-domain.com,https://admin.your-domain.com

# =============================================================================
# DEPLOYMENT EXAMPLES
# =============================================================================

# --- RENDER BACKEND DEPLOYMENT ---
# Use these settings when deploying backend to Render:
# PORT=10000 (Render will set this automatically)
# NODE_ENV=production
# API_BASE_URL=https://your-backend.onrender.com
# API_URL=https://your-backend.onrender.com/api
# SOCKET_URL=https://your-backend.onrender.com
# HEALTH_CHECK_URL=https://your-backend.onrender.com/api/health
# FRONTEND_URL=https://your-frontend.vercel.app
# CORS_ORIGINS=https://your-frontend.vercel.app

# --- VERCEL FRONTEND DEPLOYMENT ---
# Set these in your Angular environment files:
# API_URL=https://your-backend.onrender.com/api
# SOCKET_URL=https://your-backend.onrender.com

# --- DOCKER DEPLOYMENT ---
# For Docker containers, use service names:
# API_BASE_URL=http://backend:3000
# API_URL=http://backend:3000/api
# FRONTEND_URL=http://frontend:80
# HEALTH_CHECK_URL=http://backend:3000/api/health

# --- SSL/HTTPS CONFIGURATION ---
# When using HTTPS (recommended for production):
# All URLs should use https:// protocol
# Ensure SSL certificates are properly configured
# Update health checks to use HTTPS endpoints

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================

# Email service configuration (Gmail example - use App Password)
# For production, consider using dedicated email services like SendGrid
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_specific_password

# =============================================================================
# HOSPITAL FEATURE CONFIGURATION
# =============================================================================

# API rate limiting configuration
API_RATE_LIMIT=100

# Hospital API key configuration
HOSPITAL_API_KEY_PREFIX=HK_
HOSPITAL_API_SECRET_LENGTH=64

# =============================================================================
# PAYMENT GATEWAY CONFIGURATION
# =============================================================================

# Razorpay Configuration
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
UPI_ID=9909232769@superyes

# Kotak UPI Payment Gateway Configuration
KOTAK_API_BASE_URL=https://apigwuat.kotak.com:8443
KOTAK_CLIENT_ID=your_kotak_client_id
KOTAK_CLIENT_SECRET=your_kotak_client_secret
KOTAK_MERCHANT_VPA=merchant@kotak
KOTAK_MERCHANT_MOBILE=919XXXXXXXXX
KOTAK_AGGREGATOR_ID=AC001
KOTAK_MERCHANT_ID=MC001
KOTAK_SECRET_KEY=your_kotak_secret_key

# Payment timeout and retry configuration
PAYMENT_TIMEOUT_MINUTES=10
PAYMENT_POLL_INTERVAL_SECONDS=5
PAYMENT_MAX_RETRIES=3

# =============================================================================
# QUICK SETUP GUIDES
# =============================================================================

# 1. LOCAL DEVELOPMENT SETUP:
#    - Keep all localhost URLs as shown above
#    - Start MongoDB locally or use MongoDB Atlas
#    - Run: npm run dev

# 2. RENDER BACKEND DEPLOYMENT:
#    - Set NODE_ENV=production
#    - Update all URLs to use your Render domain
#    - Set MONGODB_URI to your cloud database
#    - Render will automatically set PORT

# 3. VERCEL FRONTEND DEPLOYMENT:
#    - Update Angular environment files with production API_URL
#    - Set build environment variables in Vercel dashboard
#    - Ensure CORS_ORIGINS includes your Vercel domain

# 4. DOCKER DEPLOYMENT:
#    - Use service names instead of localhost
#    - Configure health check URLs for container orchestration
#    - Set appropriate network configurations

# =============================================================================
# SECURITY NOTES
# =============================================================================

# - Never commit actual secrets to version control
# - Use strong, unique passwords and keys for production
# - Regularly rotate API keys and secrets
# - Use HTTPS in production environments
# - Validate all environment variables at startup
# - Monitor and log configuration errors
