# =============================================================================
# RENDER DEPLOYMENT ENVIRONMENT VARIABLES TEMPLATE
# =============================================================================
# 
# Instructions:
# 1. Copy this file to create your production environment configuration
# 2. Replace all placeholder values with your actual production values
# 3. Add these variables to your Render service dashboard
# 4. NEVER commit actual secrets to version control
#
# =============================================================================

# =============================================================================
# CORE CONFIGURATION
# =============================================================================

# Environment mode - MUST be production for Render
NODE_ENV=production

# Port - Render will set this automatically, but you can specify
PORT=10000

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# MongoDB Atlas connection string
# Format: mongodb+srv://username:password@cluster.mongodb.net/database
# REQUIRED: Replace with your actual MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/healthcare-platform

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# JWT secret key - CRITICAL: Generate a secure 64-character string
# Use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# REQUIRED: Replace with your generated JWT secret
JWT_SECRET=your_64_character_jwt_secret_key_generate_securely_for_production

# JWT token expiration time
JWT_EXPIRES_IN=24h

# Encryption master key for E2E message encryption
# CRITICAL: Must be exactly 64 characters (hex)
# Use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# REQUIRED: Replace with your generated encryption key
ENCRYPTION_MASTER_KEY=your_64_character_hex_encryption_master_key_here_make_it_secure_and_random

# =============================================================================
# URL CONFIGURATION - CRITICAL FOR DEPLOYMENT
# =============================================================================

# Backend base URL - Replace 'your-backend' with your actual Render service name
# Format: https://your-service-name.onrender.com
# REQUIRED: Update with your actual Render service URL
API_BASE_URL=https://your-backend.onrender.com

# Backend API URL - Same as API_BASE_URL but with /api suffix
# REQUIRED: Update with your actual Render service URL
API_URL=https://your-backend.onrender.com/api

# WebSocket/Socket.IO URL - Same as API_BASE_URL
# REQUIRED: Update with your actual Render service URL
SOCKET_URL=https://your-backend.onrender.com

# Health check endpoint URL - Used by Render for health monitoring
# REQUIRED: Update with your actual Render service URL
HEALTH_CHECK_URL=https://your-backend.onrender.com/api/health

# Frontend application URL - Where your Angular app is deployed
# Common platforms: Vercel, Netlify, Firebase Hosting
# REQUIRED: Replace with your actual frontend URL
FRONTEND_URL=https://your-frontend.vercel.app

# =============================================================================
# CORS CONFIGURATION
# =============================================================================

# Allowed CORS origins - Comma-separated list of frontend URLs
# CRITICAL: Must include all domains that will access your API
# REQUIRED: Update with your actual frontend URL(s)
CORS_ORIGINS=https://your-frontend.vercel.app

# Examples for multiple domains:
# CORS_ORIGINS=https://your-frontend.vercel.app,https://your-domain.com,https://admin.your-domain.com

# =============================================================================
# EMAIL CONFIGURATION (Optional but recommended)
# =============================================================================

# Email service configuration for notifications
# For Gmail: Use App Password, not regular password
# OPTIONAL: Add if you want email notifications
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_specific_password

# =============================================================================
# PAYMENT GATEWAY CONFIGURATION (Optional)
# =============================================================================

# Razorpay Configuration
# OPTIONAL: Add if using Razorpay payments
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# UPI ID for payments
UPI_ID=your_upi_id@provider

# Kotak UPI Payment Gateway Configuration
# OPTIONAL: Add if using Kotak UPI payments
KOTAK_API_BASE_URL=https://apigwuat.kotak.com:8443
KOTAK_CLIENT_ID=your_kotak_client_id
KOTAK_CLIENT_SECRET=your_kotak_client_secret
KOTAK_MERCHANT_VPA=merchant@kotak
KOTAK_MERCHANT_MOBILE=919XXXXXXXXX
KOTAK_AGGREGATOR_ID=AC001
KOTAK_MERCHANT_ID=MC001
KOTAK_SECRET_KEY=your_kotak_secret_key

# =============================================================================
# HOSPITAL FEATURE CONFIGURATION (Optional)
# =============================================================================

# API rate limiting
API_RATE_LIMIT=100

# Hospital API key configuration
HOSPITAL_API_KEY_PREFIX=HK_
HOSPITAL_API_SECRET_LENGTH=64

# =============================================================================
# PAYMENT TIMEOUT CONFIGURATION (Optional)
# =============================================================================

# Payment processing timeouts
PAYMENT_TIMEOUT_MINUTES=10
PAYMENT_POLL_INTERVAL_SECONDS=5
PAYMENT_MAX_RETRIES=3

# =============================================================================
# RENDER-SPECIFIC CONFIGURATION NOTES
# =============================================================================

# 1. SERVICE URL FORMAT:
#    Your Render service URL will be: https://your-service-name.onrender.com
#    Replace 'your-service-name' with your actual service name

# 2. HEALTH CHECKS:
#    Render automatically uses the healthCheckPath from render.yaml
#    Default: /api/health

# 3. ENVIRONMENT VARIABLES:
#    Add these variables in Render Dashboard → Your Service → Environment
#    Click "Add Environment Variable" for each one

# 4. SECURITY:
#    - Never commit this file with actual values to version control
#    - Use strong, unique passwords and keys
#    - Regularly rotate secrets
#    - Monitor access logs

# 5. DEPLOYMENT:
#    - Render auto-deploys on git push to configured branch
#    - Monitor build logs for configuration errors
#    - Test all endpoints after deployment

